# Local development settings. In production these come from Google Secret Manager and Cloud Run environment variables.

# Postgres connection string (required). In production: the BASE_PULSE_DATABASE_URL secret.
DATABASE_URL=postgres://user:password@localhost:5432/base_pulse

# Base RPC endpoints. Without them the public, rate-limited endpoints are used.
BASE_RPC_URL=
BASE_SEPOLIA_RPC_URL=

# Sent as x-api-key, gives the owner unlimited calls and access to the /owner dashboard.
OWNER_API_KEY=

# Key for hashing caller networks (free-call counts, usage stats). Any long random string.
CALLER_HASH_SECRET=

# Forces one x402 facilitator. Leave empty for Coinbase first, PayAI as backup.
X402_FACILITATOR_URL=

# Google Cloud project, used to read the secrets above from Secret Manager.
GCP_PROJECT_ID=
